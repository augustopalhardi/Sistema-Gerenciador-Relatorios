<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.2"
    xmlns="http://xmlns.jcp.org/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd">

    <!--
      URL, usuario e senha do banco NAO ficam aqui: sao lidos do arquivo de
      configuracao externo (ver Config e EntityManagerProducer).
    -->
    <persistence-unit name="relatoriosPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.augustopalhardi.relatorios.model.CadastroCliente</class>
        <class>com.augustopalhardi.relatorios.model.CadastroUsuario</class>
        <class>com.augustopalhardi.relatorios.model.DadosEmpresa</class>
        <class>com.augustopalhardi.relatorios.model.FotoCampo</class>
        <class>com.augustopalhardi.relatorios.model.Relatorio</class>
        <class>com.augustopalhardi.relatorios.model.RelatorioFormatado</class>
        <class>com.augustopalhardi.relatorios.model.SubtopicoRelatorio</class>
        <class>com.augustopalhardi.relatorios.model.TopicoRelatorio</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="javax.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver" />

            <!-- cria/atualiza as tabelas no primeiro start -->
            <property name="hibernate.hbm2ddl.auto" value="update" />
            <property name="hibernate.show_sql" value="false" />
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL8Dialect" />
            <property name="hibernate.jdbc.time_zone" value="America/Sao_Paulo" />

            <property name="hibernate.c3p0.initialPoolSize" value="5" />
            <property name="hibernate.c3p0.minPoolSize" value="5" />
            <property name="hibernate.c3p0.maxPoolSize" value="20" />
            <property name="hibernate.c3p0.maxIdleTime" value="300" />
            <property name="hibernate.c3p0.testConnectionOnCheckout" value="false" />
            <property name="hibernate.c3p0.testConnectionOnCheckin" value="true" />
            <property name="hibernate.c3p0.idleConnectionTestPeriod" value="60" />
            <property name="hibernate.c3p0.acquireRetryAttempts" value="1" />
            <property name="hibernate.c3p0.acquireRetryDelay" value="250" />

            <property name="hibernate.connection.autocommit" value="false" />
        </properties>
    </persistence-unit>
</persistence>
